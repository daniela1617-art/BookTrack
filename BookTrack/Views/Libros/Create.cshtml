@model BookTrack.Models.Libro

@{
    ViewData["Title"] = "Agregar libro";
}

<div class="bt-form-page">
    <div class="bt-form-header">
        <a asp-action="Index" class="bt-back-link">← Volver al catálogo</a>
        <span class="bt-eyebrow">BOOKTRACK · BIBLIOTECA DIGITAL</span>
        <h1>Agregar nuevo libro</h1>
        <p>Completa la información para registrar un libro en la biblioteca.</p>
    </div>

    <div class="bt-form-card">
        <div class="bt-form-card-title">
            <div class="bt-form-icon">📚</div>
            <div>
                <h3>Información del libro</h3>
                <p>Todos los campos deben completarse correctamente.</p>
            </div>
        </div>

        <hr />

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label">Título del libro</label>
                <input asp-for="Titulo" class="form-control" placeholder="Ej. El principito" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Autor" class="form-label">Autor</label>
                <input asp-for="Autor" class="form-control" placeholder="Nombre del autor" />
                <span asp-validation-for="Autor" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Genero" class="form-label">Género literario</label>
                <input asp-for="Genero" class="form-control" placeholder="Ej. Novela, Ciencia ficción, Fábula..." />
                <span asp-validation-for="Genero" class="text-danger"></span>
            </div>

            <div class="bt-form-row">
                <div class="mb-3">
                    <label asp-for="AnioPublicacion" class="form-label">Año de publicación</label>
                    <input asp-for="AnioPublicacion" class="form-control" placeholder="Ej. 1943" />
                    <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EjemplaresDisponibles" class="form-label">Ejemplares disponibles</label>
                    <input asp-for="EjemplaresDisponibles" class="form-control" placeholder="Ej. 5" />
                    <span asp-validation-for="EjemplaresDisponibles" class="text-danger"></span>
                </div>
            </div>

            <div class="bt-form-actions">
                <a asp-action="Index" class="bt-cancel-button">Cancelar</a>
                <button type="submit" class="bt-add-button">Guardar libro</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
