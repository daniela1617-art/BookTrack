@{
    ViewData["Title"] = "Inicio";
}

<div class="bt-home">

    <section class="bt-hero">
        <div class="bt-hero-content">
            <span class="bt-eyebrow">BOOKTRACK · SISTEMA DE BIBLIOTECA</span>

            <h1>Un mundo de historias,<br />a un solo lugar.</h1>

            <p>
                Organiza, consulta y administra tu colección de libros de manera sencilla.
                BookTrack te permite llevar el control de tu biblioteca desde una sola plataforma.
            </p>

            <a asp-controller="Libros" asp-action="Index" class="bt-add-button">
                Explorar catálogo <span>→</span>
            </a>
        </div>

        <div class="bt-hero-visual">
            <div class="bt-hero-book bt-hero-book-one">📘</div>
            <div class="bt-hero-book bt-hero-book-two">📕</div>
            <div class="bt-hero-book bt-hero-book-three">📗</div>
            <div class="bt-hero-circle">
                <span>📚</span>
                <strong>BookTrack</strong>
                <small>Tu biblioteca digital</small>
            </div>
        </div>
    </section>

    <section class="bt-home-info">
        <div class="bt-home-info-card">
            <span>📚</span>
            <h3>Catálogo organizado</h3>
            <p>Consulta todos los libros registrados y encuentra su información rápidamente.</p>
            </div>

            <div class="bt-home-info-card">
                <span>✏️</span>
                <h3>Administración sencilla</h3>
                <p>Registra nuevos libros, actualiza sus datos o elimina registros cuando sea necesario.</p>
            </div>

            <div class="bt-home-info-card">
                <span>📖</span>
                <h3>Control de ejemplares</h3>
                <p>Mantén un registro de los ejemplares disponibles en tu biblioteca.</p>
            </div>
        </section>

    </div>